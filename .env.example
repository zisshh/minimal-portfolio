# ---- Contact form (Resend — https://resend.com) ----
# Without these, the form shows a friendly "email me directly" message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=thkrdiv@gmail.com
# Until you verify a domain in Resend, the test sender works for sends to your own inbox:
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ---- Visitor counter (Upstash Redis or Vercel KV) ----
# Either UPSTASH_* or KV_REST_API_* is accepted. Without them, a non-persistent
# in-memory counter is used (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Site URL (metadata, sitemap, robots, OpenGraph) ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com
